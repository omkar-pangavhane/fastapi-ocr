# App
APP_NAME=OCR Extraction API
APP_VERSION=1.0.0
DEBUG=False

# Upload limits
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=jpg,jpeg,png,tiff,tif,bmp

# Tesseract
# On Windows set the full path, e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
DEFAULT_OCR_LANGUAGE=eng

# Batch processing
MAX_BATCH_FILES=10

# CORS
CORS_ORIGINS=*
